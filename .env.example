# Gemini API Key for Auto-Annotation & Symbol Detection (gemini-3.8-flash)
# Paste your Google AI Studio API key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for Vision Hopping (Primary fallback: Qwen on Groq)
# Paste your Groq API key below:
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Primary: qwen/qwen3.8-27b, Fallback: qwen/qwen3.6-27b)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b

# Local Ultralytics YOLO Configuration (Primary detector: 26n -> 11 -> Cloud APIs)
ENABLE_LOCAL_YOLO=true
YOLO_CONF=0.20

# Optional server configuration (default is 3000)
# PORT=3000
